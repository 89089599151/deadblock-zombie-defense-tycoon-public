-- Outpost economy: build pads, turret roles, walls, engineers, portal, persistence.
return function(root, config)
	local results = {}
	local function check(name, body)
		local ok, err = pcall(body)
		table.insert(results, {name=name, passed=ok, message=if ok then "PASS" else tostring(err)})
	end
	local TurretMath = require(game:GetService("ReplicatedStorage").DeadblockShared.TurretMath)
	local function tycoon() return require(root.TycoonModel).new(config, 101) end
	local sequence = 0
	local function action(kind, id, level, turretType)
		sequence += 1
		return {kind=kind, targetId=id, expectedLevel=level, turretType=turretType, requestId="s3-"..sequence}
	end

	check("a gun costs 75 and upgrades for 120 then 264 up to the world cap", function()
		local t = tycoon() t:Credit(75 + 120 + 264 + 1000)
		assert(t:Apply(101, action("BuildTurret", 1, nil, "Gun")).ok and t.turrets[1].type == "Gun" and t.turrets[1].level == 1)
		assert(t.money == 120 + 264 + 1000)
		assert(t:Apply(101, action("UpgradeTurret", 1, 1)).ok and t.money == 264 + 1000)
		assert(t:Apply(101, action("UpgradeTurret", 1, 2)).ok and t.money == 1000 and t.turrets[1].level == 3)
		local capped = t:Apply(101, action("UpgradeTurret", 1, 3))
		assert(not capped.ok and capped.code == "max_level" and t.money == 1000)
	end)
	check("occupied pads, unknown types and invalid pads are rejected", function()
		local t = tycoon() t:Credit(1000)
		assert(t:Apply(101, action("BuildTurret", 2, nil, "Gun")).ok)
		assert(not t:Apply(101, action("BuildTurret", 2, nil, "Flamer")).ok and t.turrets[2].type == "Gun")
		assert(not t:Apply(101, action("BuildTurret", 3, nil, "Laser")).ok)
		assert(not t:Apply(101, action("BuildTurret", 33, nil, "Gun")).ok)
		assert(not t:Apply(101, action("BuildTurret", 0, nil, "Gun")).ok)
		assert(t.money == 925)
	end)
	check("turret roles unlock with the base level and pads with expansions", function()
		local t = tycoon() t:Credit(5000)
		local locked = t:Apply(101, action("BuildTurret", 1, nil, "Sniper"))
		assert(not locked.ok and locked.code == "locked")
		assert(not t:Apply(101, action("BuildTurret", 9, nil, "Gun")).ok, "pad 9 belongs to base level 2")
		assert(t:Apply(101, action("BuyDropper", 2)).ok and t:Apply(101, action("ExpandBase", 1)).ok)
		assert(t:Apply(101, action("BuildTurret", 1, nil, "Sniper")).ok)
		assert(t:Apply(101, action("BuildTurret", 9, nil, "Flamer")).ok)
		assert(not t:Apply(101, action("BuildTurret", 10, nil, "Tesla")).ok)
	end)
	check("selling refunds half of everything invested", function()
		local t = tycoon() t:Credit(195)
		assert(t:Apply(101, action("BuildTurret", 4, nil, "Gun")).ok and t:Apply(101, action("UpgradeTurret", 4, 1)).ok and t.money == 0)
		assert(t:Apply(101, action("SellTurret", 4, 2)).ok and t.money == 97 and t.turrets[4] == nil)
		assert(not t:Apply(101, action("SellTurret", 4, 2)).ok and t.money == 97)
	end)
	check("duplicate request ids charge once and foreign players cannot build", function()
		local t = tycoon() t:Credit(200)
		local request = action("BuildTurret", 5, nil, "Gun")
		assert(t:Apply(101, request).ok and t:Apply(101, request).ok and t.money == 125)
		assert(not t:Apply(999, action("BuildTurret", 6, nil, "Gun")).ok and t.turrets[6] == nil)
	end)
	check("walls cost 250 then 650 and stop at level 3 in the first world", function()
		local t = tycoon() t:Credit(900 + 5000)
		assert(t:Apply(101, action("UpgradeWalls", 1, 1)).ok and t:Apply(101, action("UpgradeWalls", 1, 2)).ok)
		assert(t.wallLevel == 3 and t.money == 5000)
		assert(not t:Apply(101, action("UpgradeWalls", 1, 3)).ok and t.money == 5000)
	end)
	check("engineers cost 200/500/1200/3000/7500 and the sixth is refused", function()
		local t = tycoon() t:Credit(12400 + 9999)
		for hired = 0, 4 do assert(t:Apply(101, action("HireEngineer", 1, hired)).ok) end
		assert(t.engineers == 5 and t.money == 9999)
		assert(not t:Apply(101, action("HireEngineer", 1, 5)).ok and t.money == 9999)
	end)
	check("the portal needs wave 15 and money, then the next world raises the cap", function()
		local t = tycoon() t:Credit(25000)
		local early = t:Apply(101, action("BuyPortal", 2))
		assert(not early.ok and early.code == "requirement" and t.unlockedWorld == 1)
		assert(not t:SetWorld(2))
		t:RecordWave(16, 15)
		assert(t:Apply(101, action("BuyPortal", 2)).ok and t.unlockedWorld == 2 and t.money == 0)
		assert(not t:Apply(101, action("BuyPortal", 3)).ok)
		assert(t:SetWorld(2) and t.worldId == 2 and t:GetLevelCap() == 6)
		assert(t:GetProgress().wave == 1, "world 2 starts at wave 1")
		assert(t:SetWorld(1) and t:GetProgress().best == 15, "world 1 progress is kept")
	end)
	check("armor reduces normal hits but not fire or piercing", function()
		assert(TurretMath.AfterArmor(config, 6, "Normal", 4) == 2)
		assert(math.abs(TurretMath.AfterArmor(config, 2, "Normal", 4) - 0.3) < 1e-9)
		assert(TurretMath.AfterArmor(config, 5, "Fire", 4) == 5 and TurretMath.AfterArmor(config, 70, "Pierce", 8) == 70)
	end)
	check("profiles round-trip and bad saved values are clamped", function()
		local Model = require(root.TycoonModel)
		local t = tycoon() t:Credit(5000)
		t:Apply(101, action("BuyDropper", 2)) t:Apply(101, action("ExpandBase", 1))
		t:Apply(101, action("BuildTurret", 3, nil, "Flamer")) t:Apply(101, action("HireEngineer", 1, 0))
		t:RecordWave(7, 6)
		local copy = Model.FromProfile(config, 101, t:ToProfile())
		assert(copy.money == t.money and copy.expansion == 1 and copy.droppers[2] == 1 and copy.turrets[3].type == "Flamer")
		assert(copy.engineers == 1 and copy:GetProgress().wave == 7 and copy:GetProgress().best == 6)
		local bad = Model.FromProfile(config, 101, { schema = 1, money = -50, expansion = 99, unlockedWorld = 1, worldId = 3,
			turrets = { ["1"] = { "Laser", 2 }, ["2"] = { "Gun", 50 }, ["99"] = { "Gun", 1 } }, wallLevel = 0, engineers = 40 })
		assert(bad.money == 0 and bad.expansion == #config.Expansions and bad.worldId == 1)
		assert(bad.turrets[1] == nil and bad.turrets[2].level == config.MaxLevel and bad.turrets[99] == nil)
		assert(bad.wallLevel == 1 and bad.engineers == config.Engineers.MaxCount and bad.droppers[1] == 1)
		assert(not pcall(Model.FromProfile, config, 101, { schema = 2 }))
	end)

	local passed = 0
	for _, r in ipairs(results) do if r.passed then passed += 1 end end
	return {total=#results, passed=passed, results=results}
end
