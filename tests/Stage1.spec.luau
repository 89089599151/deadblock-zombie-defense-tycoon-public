-- Behavioral checks; invoked explicitly in Studio, never by the live game.
return function(root)
	local results = {}
	local function check(name, body)
		local ok, message = pcall(body)
		table.insert(results, { name = name, passed = ok, message = if ok then "PASS" else tostring(message) })
	end
	local function production()
		local module = root:FindFirstChild("ProductionModel")
		assert(module, "ProductionModel is not implemented")
		return require(module).new({ Interval = 2, TravelTime = 2, Value = 5 })
	end
	check("collector earns only when ore reaches the end", function()
		local model = production()
		assert(model:Advance(1) == 0, "No payout before arrival")
		assert(model:Advance(1) == 5, "First ore pays 5 at two seconds")
		assert(model:Advance(0) == 0, "Same instant cannot pay twice")
		assert(model:Advance(8) == 20, "Four more ores pay 20")
	end)
	check("fractional frame time is preserved", function()
		local model = production()
		assert(model:Advance(0.35) == 0)
		assert(model:Advance(0.65) == 0)
		assert(model:Advance(0.75) == 0)
		assert(model:Advance(0.25) == 5)
	end)
	check("long server frames have bounded visuals and correct income", function()
		local model = production()
		assert(model:Advance(120) == 300)
		local ores = model:GetActiveOres()
		assert(#ores == 1, "Only the currently travelling ore remains")
		assert(ores[1].id == 61 and ores[1].progress == 0)
	end)
	check("each model belongs to an independent production line", function()
		local first, second = production(), production()
		assert(first:Advance(10) == 25)
		assert(second:Advance(2) == 5)
		assert(first:Advance(0) == 0)
	end)
	check("two plots assign uniquely and report full capacity", function()
		local module = root:FindFirstChild("PlotRegistry")
		assert(module, "PlotRegistry is not implemented")
		local registry = require(module).new(2)
		assert(registry:Claim(101) == 1)
		assert(registry:Claim(202) == 2)
		assert(registry:Claim(101) == 1, "Claim must be idempotent")
		assert(registry:Claim(303) == nil, "No phantom third plot")
	end)
	check("released plot never keeps or releases a different owner's claim", function()
		local module = root:FindFirstChild("PlotRegistry")
		assert(module, "PlotRegistry is not implemented")
		local registry = require(module).new(2)
		registry:Claim(101)
		registry:Claim(202)
		assert(registry:Release(101) == 1)
		assert(registry:Get(101) == nil)
		assert(registry:Claim(303) == 1)
		assert(registry:Release(101) == nil)
		assert(registry:Get(303) == 1)
	end)
	local passed = 0
	for _, result in ipairs(results) do if result.passed then passed += 1 end end
	return { passed = passed, total = #results, results = results }
end
