return function(root, config)
	local results = {}
	local function check(name, body)
		local ok, err = pcall(body)
		table.insert(results, {name=name, passed=ok, message=if ok then "PASS" else tostring(err)})
	end
	local function model()
		return require(root.ProductionModel).new({Interval=2,TravelTime=2,Value=5})
	end
	local function tycoon()
		assert(root:FindFirstChild("TycoonModel"), "TycoonModel not implemented")
		return require(root.TycoonModel).new(config,101)
	end
	local sequence=0
	local function action(kind,id,level)
		sequence+=1
		return {kind=kind,targetId=id,expectedLevel=level,requestId="spec-"..sequence}
	end
	check("upgrade preserves existing ore value and production phase",function()
		local p=model() p:Advance(1) p:SetValue(10)
		assert(p:Advance(1)==5,"In-flight ore must still pay 5")
		assert(p:Advance(2)==10,"Next ore must pay upgraded 10")
	end)
	check("upgrade at spawn boundary never retroactively reprices ore",function()
		local p=model() assert(p:Advance(2)==5) p:SetValue(20)
		assert(p:Advance(2)==5,"Ore emitted exactly at upgrade time already exists")
		assert(p:Advance(2)==20)
	end)
	check("several upgrades before next emission do not create or lose ore",function()
		local p=model() p:Advance(1) p:SetValue(10) p:SetValue(20)
		assert(p:Advance(1)==5)
		local credit,count=p:Advance(8)
		assert(credit==80 and count==4)
		assert(#p:GetActiveOres()==1)
	end)
	check("first purchase is atomic and duplicate request is idempotent",function()
		local t=tycoon() t:Credit(100)
		local request=action("BuyDropper",2)
		assert(t:Apply(101,request).ok)
		assert(t.money==0 and t.droppers[2]==1)
		assert(t:Apply(101,request).ok and t.money==0)
	end)
	check("insufficient funds and locked land change nothing",function()
		local t=tycoon() t:Credit(99)
		assert(not t:Apply(101,action("BuyDropper",2)).ok)
		assert(t.money==99 and t.droppers[2]==nil)
		t:Credit(2000)
		assert(not t:Apply(101,action("BuyDropper",3)).ok)
		assert(t.money==2099 and t.droppers[3]==nil)
	end)
	check("upgrade has server price, stale level and max level guards",function()
		local t=tycoon() t:Credit(1000)
		assert(t:Apply(101,action("UpgradeDropper",1,1)).ok)
		assert(t.money==925 and t.droppers[1]==2)
		assert(not t:Apply(101,action("UpgradeDropper",1,1)).ok)
		assert(t.money==925)
		assert(t:Apply(101,action("UpgradeDropper",1,2)).ok)
		assert(t.money==725 and t.droppers[1]==3)
		assert(not t:Apply(101,action("UpgradeDropper",1,3)).ok)
		assert(t.money==725)
	end)
	check("buying land unlocks additional droppers without resetting progress",function()
		local t=tycoon() t:Credit(1000)
		assert(t:Apply(101,action("BuyDropper",2)).ok)
		assert(t:Apply(101,action("ExpandBase",1)).ok)
		assert(t.money==650 and t.expansion==1)
		assert(t:Apply(101,action("BuyDropper",3)).ok)
		assert(t.money==300 and t.droppers[1]==1 and t.droppers[2]==1 and t.droppers[3]==1)
	end)
	check("another player cannot spend money or modify expansion",function()
		local t=tycoon() t:Credit(500)
		assert(not t:Apply(202,action("BuyDropper",2)).ok)
		assert(not t:Apply(202,action("UpgradeDropper",1,1)).ok)
		assert(not t:Apply(202,action("ExpandBase",1)).ok)
		assert(t.money==500 and t.droppers[1]==1 and t.expansion==0)
	end)
	check("malformed requests never create a purchase",function()
		local t=tycoon() t:Credit(500)
		for _,request in ipairs({{kind="BuyDropper",targetId=0,requestId="x"},{kind="BuyDropper",targetId=0/0,requestId="y"},{kind="BuyDropper",targetId=2,requestId=""},{kind="Unknown",targetId=2,requestId="z"}}) do
			assert(not t:Apply(101,request).ok)
		end
		assert(t.money==500 and t.droppers[2]==nil)
	end)
	check("feedback sends immutable economy results without mutating them",function()
		local t=tycoon() t:Credit(100)
		local request=action("BuyDropper",2)
		local result=t:Apply(101,request)
		local sent=nil
		local remote={Feedback={FireClient=function(_,_,payload) sent=payload end}}
		local service=require(root.PurchaseService).new(config,nil,nil,nil,remote)
		service:Respond({},result,request.requestId)
		assert(sent and sent.ok and sent.requestId==request.requestId)
	end)
	local passed=0
	for _,result in ipairs(results) do if result.passed then passed+=1 end end
	return {passed=passed,total=#results,results=results}
end
